{
  "name": "appointment-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Appointment booking API (NestJS, PostgreSQL, Prisma, Socket.IO, OpenAPI)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "socket:listen": "ts-node scripts/socket-listen.ts",
    "test": "jest --config test/jest-e2e.config.ts",
    "test:ci": "dotenv-cli -e .env.test -- sh -c 'prisma migrate deploy && prisma db seed && jest --config test/jest-e2e.config.ts'",
    "test:setup": "dotenv-cli -e .env.test -- prisma migrate reset --force --skip-seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "zip": "sh scripts/make-zip.sh",
    "demo:install": "npm install --prefix demo-ui",
    "demo:dev": "npm run dev --prefix demo-ui",
    "demo:build": "npm run build --prefix demo-ui",
    "demo": "npm run demo:install && npm run demo:dev"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/websockets": "11.1.6",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "dotenv": "17.2.2",
    "dotenv-cli": "10.0.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
